{
  "name": "sahaya",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev -H 127.0.0.1",
    "dev:local": "SAHAYA_LOCAL_MODE=nonsensitive next dev -H 127.0.0.1",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "demo:medication": "vitest run --config vitest.demo.config.mts demos/medication.demo.ts",
    "demo:grocery": "vitest run --config vitest.demo.config.mts demos/grocery.demo.ts",
    "demo:meals": "vitest run --config vitest.demo.config.mts demos/meals.demo.ts",
    "demo:home-services": "vitest run --config vitest.demo.config.mts demos/homeServices.demo.ts",
    "demo:care": "vitest run --config vitest.demo.config.mts",
    "e2e": "node e2e/run-live.mjs",
    "e2e:install": "playwright install chromium"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.3.0",
    "@auth0/nextjs-auth0": "^4.33.0",
    "convex": "^1.48.0",
    "next": "16.4.3",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "^0.0.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@edge-runtime/vm": "^5.0.0",
    "@playwright/test": "^1.64.1",
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^24.19.2",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "convex-test": "^0.0.65",
    "eslint": "^9",
    "eslint-config-next": "16.4.3",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^5.0.5"
  }
}
