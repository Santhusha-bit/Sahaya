# Staging profile (template — copy into the host's secret manager; never commit real values).
# Staging runs a production build (NODE_ENV=production) against a SEPARATE Auth0 application and a SEPARATE
# Convex deployment, with synthetic data only. The server refuses to start serving if any rule in
# src/lib/security/envCheck.ts fails.
NODE_ENV=production
APP_BASE_URL=https://staging.sahaya.example
SAHAYA_AUTH=auth0
SAHAYA_STORAGE=convex
# Keep this unset until docs/privacy-and-vendors.md §3 is complete:
# SAHAYA_REAL_HEALTH_DATA=approved
AUTH0_DOMAIN=<staging-tenant>.us.auth0.com
AUTH0_CLIENT_ID=<staging app client id>
AUTH0_CLIENT_SECRET=<from secret manager>
AUTH0_SECRET=<openssl rand -hex 32>
NEXT_PUBLIC_CONVEX_URL=https://<staging-deployment>.convex.cloud
CONVEX_DEPLOYMENT=dev:<staging-deployment>   # name only — never a deploy key
ANTHROPIC_API_KEY=<from secret manager>
CARTESIA_API_KEY=<from secret manager>
# Must NOT be set here: SAHAYA_LOCAL_MODE, SAHAYA_STORE=file, CONVEX_DEPLOY_KEY (CI only), any secret in NEXT_PUBLIC_*.
