# Sahaya environment configuration
# Copy to .env.local and fill in the values you have. Every integration degrades
# gracefully when its key is missing and is reported honestly as
# live / sandbox / unavailable in the app (see /api/status and Profile page).

# --- Claude (agent reasoning) ---------------------------------------------
# Without this key, agents run in SANDBOX mode: deterministic stubbed responses
# that still exercise planning, tools, approvals and memory end to end.
ANTHROPIC_API_KEY=
# Optional model override. Defaults to claude-opus-4-8.
AGENT_MODEL=claude-opus-4-8

# --- Convex (primary backend: memory, events, tasks) ----------------------
# Without this, Sahaya uses an in-process store (data resets on restart).
NEXT_PUBLIC_CONVEX_URL=
CONVEX_DEPLOYMENT=

# --- Cartesia (voice) ------------------------------------------------------
# Without this, the mic uses the browser's built-in SpeechRecognition +
# speechSynthesis and the UI labels voice as "browser (sandbox)".
# With it, the scam-call demo (/call, npm run demo:scam-call) uses Cartesia end
# to end: ink-whisper STT transcribes the caller (browsers get a short-lived
# STT-only token, never this key) and sonic-3 voices Guardian's warning.
CARTESIA_API_KEY=
# Guardian's voice. Optional.
CARTESIA_VOICE_ID=
# Voice of the fictional fake grandson in the demo scam call. Optional.
CARTESIA_CALLER_VOICE_ID=

# --- Auth0 (authentication) ------------------------------------------------
# Without this, Sahaya runs in single-user demo mode (a fixed demo user).
AUTH0_DOMAIN=
AUTH0_CLIENT_ID=
AUTH0_CLIENT_SECRET=
AUTH0_SECRET=
APP_BASE_URL=http://localhost:3000

# --- Atlassian Jira (controlled agent actions) -----------------------------
# Optional. With all four set, sensitive work items mirror to Jira issues for
# human review. Without them, a local sandbox work-item store is used (same
# interface + dashboard) and the status page shows Jira as "sandbox". The code
# execution gate (hash/role/expiry/single-use) is enforced locally either way.
ATLASSIAN_SITE=
ATLASSIAN_EMAIL=
ATLASSIAN_API_TOKEN=
ATLASSIAN_PROJECT_KEY=

# --- Fetch.ai uAgents (agent-to-agent messaging) ---------------------------
# Optional. Run the uAgents (cd services/uagents && python bridge.py): each agent
# is its own process. Point each TS agent at ITS OWN uAgent. Without these, the
# same exchange runs on the in-process bus and Fetch.ai shows as "unavailable".
# See services/uagents/README.md. FETCHAI_BRIDGE_URL is the legacy name for Wellness.
FETCHAI_WELLNESS_URL=
FETCHAI_CARE_URL=
FETCHAI_FINANCE_URL=
FETCHAI_BRIDGE_URL=
# Guardian's uAgent log endpoint (Activity page live panel). Default http://127.0.0.1:8021
FETCHAI_GUARDIAN_URL=
# Shared secret the Guardian uAgent sends to /api/bridge/guardian/assistance.
# Set the same value in the uAgents' environment. Required in production.
SAHAYA_BRIDGE_TOKEN=

# --- Scam-call screening (WebRTC + Claude) --------------------------------
# Calls run peer-to-peer over WebRTC at /call; Claude screens the caller's live
# transcript (uses ANTHROPIC_API_KEY above; deterministic rules without it).
# Optional: JSON RTCIceServer[] (add a TURN relay for strict NATs). Defaults to
# Google public STUN.
# WEBRTC_ICE_SERVERS=[{"urls":"turn:turn.example.com:3478","username":"u","credential":"p"}]

# --- Twilio SMS (caregiver alerts) -----------------------------------------
# Optional. With SID + auth token + a sender, Guardian alerts and Care reminders
# are texted; otherwise they stay in-app (sandbox).
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# --- Elasticsearch (incident search) ---------------------------------------
# Optional. With both set, PII-redacted incidents are indexed in Elasticsearch
# for keyword/semantic search. Without them, a local in-memory index with the
# same interface is used and the status page shows Elastic as "sandbox".
ELASTIC_URL=
ELASTIC_API_KEY=

# --- Armadin (adversarial testing) ----------------------------------------
# Optional. Without this, `npm run redteam` runs the local adversarial suite and
# the status page labels Armadin "unavailable" (never claimed as integrated).
ARMADIN_API_KEY=

# --- Moss (continuity retrieval) -------------------------------------------
# Optional. Wellness syncs minimized, consented continuity cues (never raw
# conversation text) to a Moss index; Convex remains the canonical record.
# Create the index once in the Moss portal/SDK (REST index creation needs
# pre-computed embeddings), then set all three. Check with `npm run moss:verify`.
MOSS_PROJECT_ID=
MOSS_PROJECT_KEY=
MOSS_INDEX_NAME=
# Salt for the pseudonymous subject + opaque doc ids sent to Moss. Set in prod.
MOSS_SUBJECT_SALT=

# --- Bitdeer AI Model Studio (Wellness observation extraction) --------------
# Optional. With BITDEER_API_KEY set, Wellness extracts structured observations
# via Bitdeer's OpenAI-compatible inference API (base https://api-inference.bitdeer.ai/v1).
# Output is schema-validated + evidence-checked IN CODE before use. Without a key,
# a deterministic offline extractor with the same interface runs (labeled sandbox).
# BITDEER_MODEL must be a model from your Studio catalog, e.g. deepseek-ai/DeepSeek-V4-Flash.
BITDEER_API_KEY=
BITDEER_MODEL=deepseek-ai/DeepSeek-V4-Flash
# BITDEER_BASE_URL=https://api-inference.bitdeer.ai/v1

# --- Backboard (long-term conversational context) --------------------------
# Optional. Indexes consented hobbies / family-visit facts in one Backboard
# assistant per user (https://app.backboard.io, X-API-Key). Convex stays the
# source of truth and every hit is re-verified against it. Without a key an
# in-process sandbox with the same interface is used (labeled sandbox).
BACKBOARD_API_KEY=
# BACKBOARD_BASE_URL=https://app.backboard.io/api

# --- Tiger Data / TimescaleDB (wellness time series) -----------------------
# Optional. Tiger Data is TimescaleDB on PostgreSQL: paste the service's
# postgres:// connection string (Tiger Cloud console > service > Connect). With it
# set, the wellness sync job mirrors approved sleep/energy observations into a
# hypertable and weekly/monthly trends are computed with time_bucket. Without
# it, an in-process store computes the same aggregates (sandbox).
TIGERDATA_SERVICE_URL=

# --- Snowflake (authorized household analytics) ----------------------------
# Optional. With both set, consented household aggregates are available to
# Snowflake. Without them, aggregates are computed locally (sandbox); nothing
# leaves the device. Only authorized, de-identified aggregates ever flow here.
# The monthly family care summary also exports de-identified care facts
# (category, outcome, day) to a household_care_facts table; Snowflake computes
# the monthly totals. Tables are created on first use.
SNOWFLAKE_ACCOUNT=
SNOWFLAKE_TOKEN=
# PROGRAMMATIC_ACCESS_TOKEN (default), KEYPAIR_JWT, or OAUTH
SNOWFLAKE_TOKEN_TYPE=
SNOWFLAKE_WAREHOUSE=
SNOWFLAKE_DATABASE=
SNOWFLAKE_SCHEMA=
SNOWFLAKE_ROLE=

# --- Apify (Care grocery product search) -----------------------------------
# Optional. With APIFY_TOKEN set, Care searches real product listings by running
# an Apify Actor (default: apify~e-commerce-scraping-tool, keyword search).
# Without it, a sandbox store catalog with the same interface is used. Items the
# live search can't find fall back to the sandbox catalog and are labeled.
APIFY_TOKEN=
APIFY_ACTOR_ID=
# Comma-separated marketplace ids passed to the Actor's `marketplaces` input.
APIFY_MARKETPLACES=
APIFY_TIMEOUT_MS=60000
# Demo pacing for sandbox order tracking (ms per stage). Default 45000.
SHOP_TRACKING_STEP_MS=

# --- Apify (live grocery product discovery) ---------------------------------
# Care runs the Grocery Product Discovery Actor (actors/grocery-product-discovery)
# for each shopping list. With both set, every grocery run is a real Apify Actor
# run (run id + Console link shown on /groceries). Without them, the Actor's own
# code runs in-process against Open Prices (real prices, labeled "sandbox", never
# claimed as Apify). GROCERY_DISCOVERY_MODE=sandbox forces the offline catalog.
# (APIFY_TOKEN above is shared by both Apify flows.)
# e.g. your-username~grocery-product-discovery
APIFY_GROCERY_ACTOR_ID=
# GROCERY_DISCOVERY_MODE=local

# --- Bright Data (Care: public price verification) -------------------------
# Optional. With both set, Care verifies a product's price against current public
# Google Shopping listings via the Bright Data SERP API (POST api.brightdata.com/request).
# Create a SERP API zone in the Bright Data dashboard and put its name here. Only the
# product name is sent. Without these, labeled SAMPLE listings are used (not live
# prices) and the status page shows Bright Data as "sandbox".
BRIGHTDATA_API_TOKEN=
BRIGHTDATA_SERP_ZONE=

# --- Google Gemini (Care pantry-photo vision) -------------------------------
# Optional. With GEMINI_API_KEY set, Care sends fridge/pantry photos to Gemini to
# propose ingredients (POST .../v1beta/models/{model}:generateContent). Output is
# schema-validated in code and uncertain items are confirmed with the person before
# meal planning. Without a key, a fixed sample fridge detection is used (sandbox).
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
# GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta

# --- Coinbase x402 (paid agent services: product data) ---------------------
# Optional. With both set, Care pays for product-comparison data in Base Sepolia
# TEST USDC: it signs EIP-3009 authorizations with this funded TESTNET wallet and
# the service verifies + settles through the x402 facilitator. Mainnet is refused
# in code. Never put a wallet holding real funds here. Get test USDC from
# https://faucet.circle.com (Base Sepolia).
# Without them, a throwaway key signs the same authorizations and a local
# verifier checks them (labeled sandbox): nothing settles, no funds move.
X402_WALLET_PRIVATE_KEY=
X402_PAY_TO=
# X402_FACILITATOR_URL=https://x402.org/facilitator
# Point Care at an external/deployed copy of the service instead of in-process,
# e.g. https://sahaya-mu.vercel.app/api/x402/product-compare
# X402_SERVICE_URL=
# Optional experiment: Finance buys financial-data benchmark reports over x402.
# Always sandbox (own throwaway key, ignores X402_WALLET_PRIVATE_KEY), and Finance
# has no standing authority: every purchase needs approval of the exact quote.
# FINANCE_X402_REPORTS=on

# Optional. Capital One Nessie sandbox bank API (get a key at http://api.nessieisreal.com).
# With it set, Finance's spending review reads a real Nessie sandbox account; without it,
# a local emulator with the same API shapes is used.
NESSIE_API_KEY=
NESSIE_BASE_URL=
# --- CRS Credit API (Finance credit & identity review) ---------------------
# Optional. With both set, Finance sends real requests to the CRS SANDBOX
# (https://api-sandbox.stitchcredit.com/api; production hosts are refused):
# TransUnion credit report, TransUnion identity verification, AtData
# FraudFinder. Only CRS test identities are ever sent. Without them, an offline
# fixture of a recorded CRS sandbox response (persona P13) is used, labeled
# sandbox. CRS does not provide bank transaction monitoring.
CRS_USERNAME=
CRS_PASSWORD=
# Persona linked to the Sahaya account holder (default P13).
CRS_LINKED_PERSONA=
# Optional JSON of extra personas from the CRS Postman collection, e.g.
# {"P05":{"firstName":"..","lastName":"..","ssn":"666......","address":{...}}}
# Entries whose SSN is not in the 666 test range are ignored.
CRS_TEST_PERSONAS=
# Report config (default tu-prequal-fico9) and FraudFinder config (default fraud-finder).
CRS_TU_CONFIG=
CRS_FRAUD_CONFIG=
